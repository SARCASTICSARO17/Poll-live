# PollLive — frontend env
# Copy to backend\.env and frontend\.env before running. Real secrets never
# go into these example files.

# ===== Backend (Go/Gin) =====
# HTTP port the API + WebSocket server listens on.
PORT=8080

# MongoDB connection string (required).
MONGO_URI=mongodb://localhost:27017

# Database name.
MONGO_DATABASE=poll_live

# Redis connection string (required) — live counters + Pub/Sub.
REDIS_URL=redis://localhost:6379

# Secret used to sign JWTs (required). Use a long random value in production.
JWT_SECRET=change-me-to-a-long-random-string

# Origin of the deployed frontend, used for CORS + WebSocket origin checks.
# The dev Vite server (http://localhost:5173) is always allowed as a fallback.
FRONTEND_URL=http://localhost:3000

# ===== Frontend (Vite/React) =====
# Base URL of the backend REST API. May be relative (proxy) or absolute.
VITE_API_URL=http://localhost:8080

# WebSocket endpoint used for live results. May be relative or absolute
# (ws:// / wss://). Defaults to ws://localhost:8080.
VITE_WS_URL=ws://localhost:8080
